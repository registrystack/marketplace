{
  "name": "registrystack-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "devDependencies": {
    "playwright": "1.60.0"
  },
  "scripts": {
    "build": "astro build",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:archives": "node --test tests/private-archives/*.test.mjs",
    "check:archives": "npm run test:archives && node scripts/verify-downloads.mjs",
    "check:ci": "npm run build && npm test && node scripts/verify-catalogue.mjs",
    "check": "npm run check:ci && npm run check:archives",
    "test:e2e": "node tests/browser.mjs",
    "dev:astro": "astro dev",
    "test:funnel": "node tests/funnel-browser.mjs"
  },
  "dependencies": {
    "astro": "6.3.7"
  }
}
